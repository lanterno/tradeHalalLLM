# halal-trader — copy to .env. Only these variables are read; every other
# setting is fixed in src/halal_trader/config.py.

# ── Required ─────────────────────────────────────────────────────────────────
# Alpaca paper account: alpaca.markets → Paper Trading → API keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# OpenRouter key for GLM-5.2; the bot does not start without it.
GLM_API_KEY=
# SEC requires a contact on every request: "Your Name (you@example.com)".
EDGAR_USER_AGENT=
# Postgres. The two passwords must match (bootstrap.sh generates one).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://trader:trader-dev-only@localhost:5433/halal_trader

# ── Recommended ──────────────────────────────────────────────────────────────
# Alerts: @BotFather → /newbot; chat id from api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# News fallback (finnhub.io) and the macro calendar (fred.stlouisfed.org).
FINNHUB_API_KEY=
FRED_API_KEY=
# Lets the dashboard change state (kill-switch); empty = read-only.
# Generate with: openssl rand -hex 32
WEB_API_TOKEN=

# ── Strategies ───────────────────────────────────────────────────────────────
# The LLM day-trader and its news-reactor entries (both retired 2026-10-04).
DAY_TRADER_ENABLED=false
REACTOR_ENTRIES_ENABLED=false
# The strict-halal core portfolio, on its own Alpaca paper account.
CORE_ENABLED=false
CORE_ALPACA_API_KEY=
CORE_ALPACA_SECRET_KEY=

# ── Real money (leave as is for paper) ───────────────────────────────────────
ALPACA_PAPER_TRADE=true
# Today's I-UNDERSTAND-REAL-MONEY-<UTC date>, checked at start.
LIVE_MODE_CONFIRMATION=
CORE_PAPER=true
# Today's I-UNDERSTAND-REAL-MONEY-CORE-<UTC date>, checked at start.
CORE_LIVE_CONFIRMATION=
# The most the live core may hold invested, in dollars.
CORE_LIVE_MAX_NOTIONAL=1000.0

# ── LLM budget (USD per calendar month, under the key's own limit) ───────────
LLM_MONTHLY_LIVE_USD=25.0
LLM_MONTHLY_RESEARCH_USD=15.0

# ── Optional ─────────────────────────────────────────────────────────────────
# Zakat year end, Hijri MM-DD (e.g. 09-01 for 1 Ramadan).
ZAKAT_HAWL_HIJRI=
# Another OpenAI-compatible GLM host needs its own model id (Z.ai: glm-5.2).
GLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2
# A second endpoint for the same model, tried when the first fails.
GLM_FALLBACK_BASE_URL=
GLM_FALLBACK_MODEL=
GLM_FALLBACK_API_KEY=
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
