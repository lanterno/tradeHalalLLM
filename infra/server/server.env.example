# /etc/halabot/server.env -- the server's own settings, outside the repo.
# bootstrap.sh installs this file (root:halabot, 0640); the backup and
# health-check units read it. The bot itself never does: its settings are
# the repo's .env.

# ── Off-site backup (restic) ─────────────────────────────────────────────────
# Encrypted, deduplicated snapshots of the nightly dump. Pick one repository.
# Keep RESTIC_PASSWORD in your password manager too: without it the
# snapshots cannot be decrypted, and a lost server takes this file with it.
#
# Cloudflare R2 (S3 API; create a bucket and an R2 API token):
#   RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/halabot-backups
# Hetzner Object Storage:
#   RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/halabot-backups
# Hetzner Storage Box (SFTP on port 23; add the server's key to the box):
#   RESTIC_REPOSITORY=sftp://u123456@u123456.your-storagebox.de:23//home/halabot
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# S3-style repositories only (R2 / Object Storage access keys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 wants "auto"; Hetzner Object Storage the location (fsn1, nbg1, hel1).
AWS_DEFAULT_REGION=auto

# How many local dumps to keep under /var/backups/halabot (days).
KEEP_LOCAL_DAYS=7

# ── Health check ─────────────────────────────────────────────────────────────
# Optional dead-man switch outside this server (healthchecks.io or any URL
# that alerts when pings stop). The health timer pings it every 5 minutes
# while the fleet is healthy, so a dead server -- which cannot send its own
# Telegram alert -- is still noticed. Empty = Telegram alerts only.
HEALTHCHECK_PING_URL=
